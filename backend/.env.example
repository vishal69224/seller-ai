MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=seller_hub
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: auto-seed demo products + marketplace connections when the DB is empty
SEED_DEMO_DATA=true

# Video Generator (kie.ai) — get a key at https://kie.ai/api-key
# Never commit a real key. Leave blank if you are not demoing video generation.
KIE_API_KEY=your_kie_api_key_here
KIE_API_BASE_URL=https://api.kie.ai
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
